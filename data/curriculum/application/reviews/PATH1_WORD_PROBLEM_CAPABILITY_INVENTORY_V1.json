  "coreFindings": [
    {
      "findingId": "F01_COMPUTATION_AND_MODELING_DISTINCT",
      "statement": "數字計算與文字建模是不同能力層；算式已給定時，學生可跳過數量角色、關係辨識與列式。",
      "evidenceRefs": [
        "data/curriculum/knowledge/units/g3a_u03_3a03.knowledge-operation.json",
        "data/curriculum/knowledge/units/g4a_u02_4a02.knowledge-operation.json"
      ]
    },
    {
      "findingId": "F02_RELATION_MODELS_ALREADY_EXIST",
      "statement": "現有 canonical KPs 已包含等組量、包含除、等分除、倍數反推、餘數情境判讀、數量關係列式、和差、和倍、差倍、速率與基準量比較量等 relation models，因此不應先建立一個新的通用 word-problem KP。",
      "evidenceRefs": [
        "data/curriculum/knowledge/units/g3b_u08_3b08.knowledge-operation.json",
        "data/curriculum/knowledge/units/g3b_u01_3b01.knowledge-operation.json",
        "data/curriculum/global/candidates/r02/chunks/reviewed-source-candidates-06.json",
        "data/curriculum/global/candidates/r02/chunks/reviewed-source-candidates-08.json"
      ]
    },
    {
      "findingId": "F03_CONTEXT_IS_NOT_RELATION",
      "statement": "購物、分裝、交通、學校活動等 context family 不等於數學 relation；既有 application context binding 已將 mathRoleId、contextRoleId、quantityType、unit、unitFlow 分離。",
      "evidenceRefs": [
        "data/curriculum/application/registry/application-context-bindings.json"
      ]
    },
    {
      "findingId": "F04_UNKNOWN_ROLE_SHIFT_IS_CORE_DIFFICULTY",
      "statement": "同一等組量關係 total = amountPerGroup × groupCount，未知 total、groupCount、amountPerGroup 時分別對應乘法、包含除、等分除；不能用表面關鍵字決定運算。",
      "evidenceRefs": [
        "data/curriculum/knowledge/units/g3b_u08_3b08.knowledge-operation.json",
        "data/curriculum/knowledge/units/g3b_u01_3b01.knowledge-operation.json"
      ]
    },
    {
      "findingId": "F05_PATH1_ALREADY_HAS_FORMAL_INVERSE_RELATION_STAGE",
      "statement": "P1-12 已以 total = amountPerGroup × groupCount 為 fusion authority，正式整合求總量、求組數、求每組量，因此 P1-01 至 P1-04 的早期文字題接軌不可重複建立另一套 inverse-relation authority。",
      "evidenceRefs": [
        "data/curriculum/learning-paths/path1-integer-foundations.curriculum-matrix.json"
      ]
    }
  ],
  "modelingCapabilityPipeline": [
    {
      "stageId": "WP01_QUANTITY_EXTRACTION",
      "capability": "從文字、表格或圖像中抽取決策相關數量，保留單位與所屬實體。"
    },
    {
      "stageId": "WP02_QUANTITY_TYPING_AND_UNIT_FLOW",
      "capability": "辨認 count、amount、rate、capacity、time、price 等 quantity type，檢查單位是否能形成合理轉換。"
    },
    {
      "stageId": "WP03_ROLE_ASSIGNMENT",
      "capability": "將情境數量綁定到數學角色，例如 amountPerGroup、groupCount、totalAmount、baseAmount、comparisonAmount。"
    },
    {
      "stageId": "WP04_RELATION_RECOGNITION",
      "capability": "依數量角色與不變關係辨認 relation kernel，不依單一關鍵字猜運算。"
    },
    {
      "stageId": "WP05_UNKNOWN_ROLE_IDENTIFICATION",
      "capability": "確認題目所求角色，並區分同一 relation 下的 unknown shift。"
    },
    {
      "stageId": "WP06_EQUATION_CONSTRUCTION",
      "capability": "由 relation invariant 建立對應等式或算式，保持 quantity role 與 operation direction 正確。"
    },
    {
      "stageId": "WP07_ARITHMETIC_EXECUTION",
      "capability": "呼叫已掌握 arithmetic KP 完成計算；此層與 modeling difficulty 分離。"
    },
    {
      "stageId": "WP08_CONTEXT_INTERPRETATION_AND_VALIDATION",
      "capability": "將結果還原成題目要求的單位與語意，必要時處理餘數 floor/ceil、回代與合理性檢查。"
    }
  ],
