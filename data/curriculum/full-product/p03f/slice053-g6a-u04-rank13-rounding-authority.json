      "canonicalExpressions": [
        "exactQuotient = decimalDividend / decimalDivisor",
        "scaleFactor = 10^requestedScale",
        "scaledExact = exactQuotient * scaleFactor",
        "retainedInteger = floor(scaledExact)",
        "roundedInteger = retainedInteger + 1 iff fractionalPart(scaledExact) >= 1/2",
        "roundedQuotient = roundedInteger / scaleFactor"
      ],
      "unknownRoles": ["roundedQuotient"],
      "answerType": "decimal_approximation",
      "validationInvariants": [
        "decimalDivisor is positive and nonzero",
        "requestedScale is an integer in {0,1,2}",
        "exact rational quotient is authoritative",
        "a remainder strictly below half keeps the retained digit",
        "a remainder equal to or above half increments the retained digit",
        "roundedQuotient is emitted at exactly requestedScale fractional digits when requestedScale > 0",
        "approximation is explicitly marked and never represented as exact equality"
      ]
    }
